{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tungstate",
  "identifier": "dev.tungstate.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tungstate",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: thumb: http://thumb.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Keep folders in the shape you declared.",
    "longDescription": "Move files between machines durably, and keep folders organised.",
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5NkNFOUNGRDdCOEY3QTQKUldTazk3alh6K2xzYWNZY0REMGttMXQ1MG5jQ0s4N082blZsOHg1bFJpZzRsK3NDZzhtcUFES3gK",
      "endpoints": [
        "https://github.com/dop3ch3f/tungstate/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
