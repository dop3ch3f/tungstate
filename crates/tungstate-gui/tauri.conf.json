{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tungstate",
  "version": "0.0.1",
  "identifier": "dev.tungstate.desktop",
  "build": {
    "frontendDist": "ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tungstate",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "shortDescription": "Keep folders in the shape you declared.",
    "longDescription": "Move files between machines durably, and keep folders organised."
  }
}
